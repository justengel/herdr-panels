{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Herdr Panels",
  "version": "0.1.13",
  "identifier": "dev.herdr.panels",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:4737",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Herdr Panels",
        "url": "http://127.0.0.1:4737/",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/256x256.png",
      "icons/128x128.png",
      "icons/48x48.png",
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
